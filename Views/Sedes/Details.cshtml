@model Vencedores.Models.Sede
@{
    ViewData["Title"] = Model.Nome;
}
<div class="page-heading"><div><p class="eyebrow">LOCAL DE JOGO</p><h1>@Model.Nome</h1><p class="lead">Detalhes da sede cadastrada</p></div><div class="button-row"><a class="btn btn-secondary" asp-action="Index">Voltar</a><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.IdSede">Editar sede</a></div></div>
<div class="panel form-panel"><dl class="detail-grid"><dt>Nome</dt><dd>@Model.Nome</dd><dt>Endereço</dt><dd>@(Model.Endereco ?? "Não informado")</dd><dt>Capacidade</dt><dd>@(Model.Capacidade?.ToString() ?? "Não informada")</dd></dl></div>
