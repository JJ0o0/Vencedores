@model Vencedores.ViewModels.TimeForm
@{
    var editar = Model.IdTime != 0;
    ViewData["Title"] = editar ? "Editar time" : "Novo time";
}
<div class="page-heading"><div><p class="eyebrow">EQUIPES</p><h1>@ViewData["Title"]</h1><p class="lead">Preencha os dados principais da equipe.</p></div></div>
<form asp-action="@(editar ? "Edit" : "Create")" asp-route-id="@(editar ? (int?)Model.IdTime : null)" method="post" asp-antiforgery="true" class="panel form-panel">
    
    <input asp-for="IdTime" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <div class="field"><label asp-for="Nome"></label><input asp-for="Nome" maxlength="100" autofocus /><span asp-validation-for="Nome" class="validation"></span></div>
    <div class="form-grid"><div class="field"><label asp-for="Sigla"></label><input asp-for="Sigla" maxlength="10" placeholder="Ex.: FLA" /><span asp-validation-for="Sigla" class="validation"></span></div><div class="field"><label asp-for="Cidade"></label><input asp-for="Cidade" maxlength="100" /><span asp-validation-for="Cidade" class="validation"></span></div></div>
    <div class="form-actions"><a class="btn btn-secondary" asp-action="Index">Cancelar</a><button type="submit" class="btn btn-primary">Salvar time</button></div>
</form>
