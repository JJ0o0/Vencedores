@model Vencedores.ViewModels.TimeDetalhesViewModel
@{
    ViewData["Title"] = Model.Time.Nome;
}
<div class="page-heading"><div><p class="eyebrow">EQUIPE</p><h1>@Model.Time.Nome</h1><p class="lead">@(!string.IsNullOrWhiteSpace(Model.Time.Cidade) ? Model.Time.Cidade : "Equipe cadastrada") · @(Model.Time.Sigla ?? "Sem sigla")</p></div><div class="button-row"><a class="btn btn-secondary" asp-action="Index">Voltar</a><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Time.IdTime">Editar time</a></div></div>
<div class="dashboard-grid"><section class="panel"><div class="panel-heading"><div><h2>Jogadores</h2><p>@Model.Jogadores.Count atleta(s) neste time</p></div><a class="btn btn-secondary btn-small" asp-controller="Jogadores" asp-action="Create" asp-route-timeId="@Model.Time.IdTime">+ Jogador</a></div>
@if (Model.Jogadores.Any())
{
    <div class="list-stack">@foreach (var j in Model.Jogadores) { <a class="list-row" asp-controller="Jogadores" asp-action="Details" asp-route-id="@j.IdJogador"><span class="mini-icon">J</span><span class="grow"><strong>@j.Nome</strong><small>Jogador</small></span><span class="row-arrow">›</span></a> }</div>
}
else
{
    <div class="empty-state"><strong>Sem jogadores</strong><p>Cadastre pelo menos dois jogadores antes de iniciar o torneio.</p></div>
}</section><section class="panel"><div class="panel-heading"><h2>Ligas em que participa</h2></div>
@if (Model.Ligas.Any())
{
    <div class="list-stack">@foreach (var l in Model.Ligas) { <a class="list-row" asp-controller="Ligas" asp-action="Details" asp-route-id="@l.IdLiga"><span class="mini-icon">L</span><span class="grow"><strong>@l.Nome</strong></span><span class="row-arrow">›</span></a> }</div>
}
else
{
    <div class="empty-state"><strong>Nenhuma liga</strong><p>Inscreva o time pela página de uma liga.</p></div>
}</section></div>
