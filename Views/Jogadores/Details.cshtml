@model Vencedores.Models.Jogadore
@{
    ViewData["Title"] = Model.Nome;
}
<div class="page-heading"><div><p class="eyebrow">JOGADOR</p><h1>@Model.Nome</h1><p class="lead">Jogador cadastrado no Vencedores</p></div><div class="button-row"><a class="btn btn-secondary" asp-action="Index">Voltar</a><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.IdJogador">Editar jogador</a></div></div>
<div class="panel form-panel"><h2>Informações</h2><dl class="detail-grid"><dt>Nome</dt><dd>@Model.Nome</dd><dt>Time</dt><dd><a asp-controller="Times" asp-action="Details" asp-route-id="@Model.IdTime">@Model.IdTimeNavigation.Nome</a></dd></dl></div>
