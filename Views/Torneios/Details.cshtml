@model Vencedores.Models.Torneio
@{
    ViewData["Title"] = Model.Nome;
}
<div class="page-heading"><div><p class="eyebrow">TORNEIO</p><h1>@Model.Nome</h1><p class="lead">@Model.DataInicio.ToString("dd/MM/yyyy") a @Model.DataFinal.ToString("dd/MM/yyyy")</p></div><div class="button-row"><a class="btn btn-secondary" asp-action="Index">Voltar</a><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.IdTorneio">Editar torneio</a></div></div>
<div class="detail-cards"><section class="panel"><span class="eyebrow">SITUAÇÃO ATUAL</span><h2><span class="status status-@Model.Status.ToLowerInvariant()">@Model.Status.Replace("_", " ")</span></h2><p>@(Model.Descricao ?? "Sem descrição.")</p></section><section class="panel"><span class="eyebrow">FORMATO</span><h2>Liga de pontos corridos</h2><p>Vitória: 3 pontos · Empate: 1 ponto · Derrota: 0 pontos.</p></section></div>
<div class="panel"><div class="panel-heading"><div><h2>Liga do torneio</h2><p>Gerencie os participantes, partidas e a classificação.</p></div></div>
@if (Model.Liga is not null)
{
    <a class="feature-link" asp-controller="Ligas" asp-action="Details" asp-route-id="@Model.Liga.IdLiga"><span class="mini-icon">L</span><span class="grow"><strong>@Model.Liga.Nome</strong><small>Ver participantes e partidas</small></span><span class="row-arrow">›</span></a>
}
else
{
    <div class="empty-state"><strong>Sem liga cadastrada</strong><p>Associe uma liga a este torneio.</p><a class="btn btn-primary" asp-controller="Ligas" asp-action="Create" asp-route-torneioId="@Model.IdTorneio">Criar liga</a></div>
}
</div>
