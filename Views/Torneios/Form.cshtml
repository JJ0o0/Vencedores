@model Vencedores.ViewModels.TorneioForm
@{
    var editar = Model.IdTorneio != 0;
    ViewData["Title"] = editar ? "Editar torneio" : "Novo torneio";
}
<div class="page-heading"><div><p class="eyebrow">COMPETIÇÕES</p><h1>@ViewData["Title"]</h1><p class="lead">Configure as informações da competição.</p></div></div>
<form asp-action="@(editar ? "Edit" : "Create")" asp-route-id="@(editar ? (int?)Model.IdTorneio : null)" method="post" asp-antiforgery="true" class="panel form-panel">
<input asp-for="IdTorneio" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation"></div>
<div class="field"><label asp-for="Nome"></label><input asp-for="Nome" maxlength="100" autofocus /><span asp-validation-for="Nome" class="validation"></span></div>
<div class="field"><label asp-for="Descricao"></label><textarea asp-for="Descricao" maxlength="300" rows="3"></textarea><span asp-validation-for="Descricao" class="validation"></span></div>
<div class="form-grid"><div class="field"><label asp-for="DataInicio"></label><input asp-for="DataInicio" type="date" value="@Model.DataInicio.ToString("yyyy-MM-dd")" /><span asp-validation-for="DataInicio" class="validation"></span></div><div class="field"><label asp-for="DataFinal"></label><input asp-for="DataFinal" type="date" value="@Model.DataFinal.ToString("yyyy-MM-dd")" /><span asp-validation-for="DataFinal" class="validation"></span></div></div>
@if (editar)
{
    <div class="field"><label asp-for="Status"></label><select asp-for="Status"><option value="PLANEJADO">Planejado</option><option value="EM_ANDAMENTO">Em andamento</option><option value="FINALIZADO">Finalizado</option></select><span asp-validation-for="Status" class="validation"></span><small class="field-help">Para iniciar, a liga precisa de dois times com dois jogadores em cada elenco.</small></div>
}
else
{
    <input asp-for="Status" type="hidden" /><p class="soft-notice">Uma liga de pontos corridos será criada automaticamente. Depois, basta inscrever os times.</p>
}
<div class="form-actions"><a class="btn btn-secondary" asp-action="Index">Cancelar</a><button type="submit" class="btn btn-primary">Salvar torneio</button></div></form>
